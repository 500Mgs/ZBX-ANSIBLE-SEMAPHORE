#cloud-config
hostname: {{ vmhostname }}
fqdn: {{ vmhostname }}.local
manage_etc_hosts: true

users:
  - name: ansible
    gecos: Ansible automation
    groups: sudo
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - {{ ansible_pubkey }}

packages:
  - python3
  - python3-apt
  - openssh-server
  - sudo
  - curl
  - net-tools

package_update: true
package_upgrade: false

write_files:
  - path: /etc/ssh/sshd_config.d/99-jump-host.conf
    owner: root:root
    permissions: '0644'
    content: |
      AllowTcpForwarding yes
      GatewayPorts no
      X11Forwarding no
      ClientAliveInterval 60
      ClientAliveCountMax 3
      MaxSessions 20
      AllowAgentForwarding yes

runcmd:
  - systemctl restart ssh
  - echo "cloud-init completado" > /var/log/cloud-init-done.log